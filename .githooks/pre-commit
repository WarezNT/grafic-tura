#!/bin/sh
# Auto-update COMMIT_COUNT in index.html to match the commit about to be made.
# HEAD doesn't include this commit yet, so +1.

FILE="index.html"
[ -f "$FILE" ] || exit 0

CURRENT=$(git rev-list --count HEAD 2>/dev/null || echo 0)
NEXT=$((CURRENT + 1))

# Only touch the file if the constant is present and actually needs updating.
if grep -q "const COMMIT_COUNT = " "$FILE"; then
  sed -i "s/const COMMIT_COUNT = [0-9]*;/const COMMIT_COUNT = ${NEXT};/" "$FILE"
  git add "$FILE"
fi
