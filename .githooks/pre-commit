#!/bin/sh
# Actualizează COMMIT_COUNT (în js/core.js, comun tuturor modurilor) cu numărul commit-ului care urmează.
# HEAD nu include încă acest commit, deci +1.

FILE="js/core.js"
[ -f "$FILE" ] || exit 0

CURRENT=$(git rev-list --count HEAD 2>/dev/null || echo 0)
NEXT=$((CURRENT + 1))

if grep -q "const COMMIT_COUNT = " "$FILE"; then
  sed -i "s/const COMMIT_COUNT = [0-9]*;/const COMMIT_COUNT = ${NEXT};/" "$FILE"
  git add "$FILE"
fi
